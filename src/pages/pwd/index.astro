---
import Default from '../../templates/Default.astro';
---

<Default title="Generate Password(s)">
   <div class="container">
      <div class="list-group mt-4 mb-4 fs-6" id="generated_passphrases"></div>

      <div class="form-check mb-4">
         <input
            class="form-check-input"
            type="checkbox"
            value=""
            id="include_numbers"
         />
         <label class="form-check-label" for="include_numbers">
            Include Numbers
         </label>
      </div>

      <div class="input-group mb-5">
         <button
            id="generate_passphrases"
            class="btn btn-outline-secondary"
            type="button"
         >
            Generate Passphrases
         </button>

         <select
            class="form-select"
            id="max_word_length_val"
            aria-label="Max Word Length"
         >
            <option selected>Max Word Length...</option>
         </select>
      </div>

      <div class="alert alert-success" role="alert" id="entropy_alert">
            <span
               ><b
                  ><span id="passphrase_strength">Reasonable</span> entropy</b
               >  — 2<sup id="calculated_entropy">46</sup> bits.</span
            >
      </div>
   </div>
   <script is:inline src="/js/pwd-words.js"></script>
   <script is:inline src="/js/pwd.js"></script>
</Default>
