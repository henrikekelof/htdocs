---
import Default from '../../templates/Default.astro';
---

<Default>
   <div class="container">

      <h1 class="doc-main-heading">Generate Password(s)</h1>

      <div class="list-group mt-4 mb-4" id="generated_passphrases"></div>

      <div class="form-check mb-4">
         <input
            class="form-check-input"
            type="checkbox"
            value=""
            id="include_numbers"
         />
         <label class="form-check-label" for="include_numbers">
            Include Numbers
         </label>
      </div>

      <div class="input-group mb-4">
         <button
            id="generate_passphrases"
            class="btn btn-outline-secondary"
            type="button"
         >
            Generate Passphrases
         </button>

         <select
            class="form-select"
            id="max_word_length_val"
            aria-label="Max Word Length"
         >
            <option selected>Max Word Length...</option>
         </select>
      </div>

      <div class="alert alert-success" role="alert" id="entropy_alert">
         <h4 class="alert-heading">Entropy</h4>
         <p>
            <span
               >These settings should generate a <b
                  ><span id="passphrase_strength">Reasonable</span></b
               > passphrase with about 2<sup id="calculated_entropy">46</sup> bits
               of entropy.</span
            >
            <span id="entropy_message"
               >These passphrases should be strong enough to protect network and
               corporate accounts.</span
            >
         </p>
      </div>
   </div>
   <script is:inline src="/js/pwd-words.js"></script>
   <script is:inline src="/js/pwd.js"></script>
</Default>
